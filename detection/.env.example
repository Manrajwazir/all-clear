# ─────────────────────────────────────────────────────────────────────────────
# All Clear — detection service configuration
# Copy to detection/.env and fill in. .env is gitignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── All Clear device API (Phase 3) ──────────────────────────────────────────
#
# THIS IS THE ONLY CREDENTIAL A REAL DEVICE NEEDS.
#
# Everything below it in this file is either non-secret tuning or a leftover
# from before Phase 3 — see the note on the Supabase and S3 blocks.
#
# The key is scoped to ONE device at ONE site in ONE organisation, and can be
# revoked from the dashboard by flipping a single column. It cannot read another
# site's data, cannot delete anything, and cannot claim to belong to a different
# organisation: the server derives that from the key itself.
#
# To get one:
#   cd dashboard
#   npm run create-device -- --list-sites
#   npm run create-device -- --site <site-uuid> --name "Trailer Pi 01"
# That prints a provisioning token ONCE. Exchange it for a key:
#   curl -X POST $ALLCLEAR_API_URL/api/v1/devices/provision \
#     -H "Content-Type: application/json" \
#     -d '{"provisioning_token":"<token>"}'
# The response contains the key, also exactly once. Paste it here.
#
# ⚠ A REAL DEPLOYED DEVICE MUST USE https://. DEVICE_API_KEY below travels in an
# Authorization header on every request, so plain http would put the device's
# whole identity on the site network in cleartext. The client refuses to start
# on a plaintext http:// URL, with the single exception of loopback (localhost
# / 127.0.0.1), which is why the development default below is allowed.
ALLCLEAR_API_URL=http://localhost:3000
DEVICE_API_KEY=

# Which camera row this process reports against. NOT a credential — it is a
# selector, it is not secret, and knowing it grants nothing. The server rejects
# any camera that is not at this device's own site.
CAMERA_ID=00000000-0000-0000-0000-000000000001

# ── The camera (Labs4 block 1, C2 and C4) ───────────────────────────────────
#
# Which camera to read. One of:
#   a webcam number      0 is the laptop's own camera
#   a stream address     rtsp://192.168.1.64:554/Streaming/Channels/101
#   a video file         a path to a recording, played once, every frame in order
# Never put the login in the address (rtsp://user:pass@...): it's refused at
# start-up with exit code 4, because the address is printed in the log. The login
# goes in the two settings below, which every printout shows as ***.
CAMERA_SOURCE=0
CAMERA_USERNAME=
# Type it exactly as the camera has it. Characters like @ : / # are encoded for
# you; encoding them yourself would break the login.
CAMERA_PASSWORD=

# How a stream's video travels: tcp or udp. tcp resends anything lost, so every
# frame that arrives is whole. udp drops packets on a busy network, and one lost
# packet smears every frame until the next full one: the model would be judging
# smears. Late but whole is the right trade for a record. Ignored for a webcam or
# a file.
CAMERA_TRANSPORT=tcp

# Streams only. Connecting gives up after CAMERA_OPEN_TIMEOUT_S seconds, then
# retries after 1, 2, 4, 8, 16 s, then every 30 s, forever (the Jetson can boot
# before the camera does). No frame for CAMERA_READ_TIMEOUT_S seconds means the
# stream is lost, and a frame that turns up later than that is dropped as stale.
CAMERA_OPEN_TIMEOUT_S=10
CAMERA_READ_TIMEOUT_S=5
# A camera that answers but refuses the stream (most likely a wrong password; also
# a wrong stream path, or a camera at its viewer limit) is tried 3 times (10 if it
# has streamed before), then every CAMERA_REFUSED_WAIT_S seconds, so a wrong
# password can't get the camera's account locked.
CAMERA_REFUSED_WAIT_S=300

# ── Running unattended (Labs4 block 1, C5 and C6) ──────────────────────────
#
# Blank: decided for you. Linux with no screen (a Jetson in a trailer) runs with no
# window; anything else opens the window. true or false forces it. Any other value
# is a bad setting: exit code 4.
HEADLESS=
# How much the log says: DEBUG, INFO, WARNING or ERROR. Keep INFO on a device.
# DEBUG adds a DETECTED line for every frame of every violation (about 900 a
# minute for one worker without a hard hat): for a short debugging session only.
# WARNING would hide the STATUS lines, the record of the device watching. A wrong
# value falls back to INFO with a warning.
LOG_LEVEL=INFO
# With no window: one STATUS line this often (seconds), saying whether the device
# is watching, frames received and processed, alerts, and seconds blind. It keeps
# coming while the camera is blind.
STATUS_EVERY_S=60

# The model weights, relative to detection/ (where it runs from). Not in git
# (see the README). A file that is missing or can't be loaded is a bad setting:
# exit code 4.
MODEL_PATH=models/ppe_v1.pt

# Ask the server for an image upload URL alongside each violation.
#
# This is intent, not a switch. The client will not actually request an image
# until the server confirms the SITE captures imagery, because a snapshot
# offered to a site that has not opted in is rejected along with the WHOLE
# violation — a device misconfigured here would otherwise drop every incident
# rather than just the pictures.
SNAPSHOT_MODE=false

# How often to tell the server this device is alive. Each heartbeat says whether
# it is watching: "online" only if the model looked at a camera frame in the last
# 10 s, otherwise "degraded" with the reason (C6). The server keeps only the
# status for now; storing the reason is OPEN_ITEMS 17.7.
HEARTBEAT_SECONDS=30

# ── Outage queue (Phase 3, Step 3.5) ────────────────────────────────────────
#
# Every violation is written here BEFORE any network call, so a dropped link
# cannot lose an incident. A background thread replays anything undelivered
# with backoff (30s, 60s, 120s, 240s, then every 5 min).
#
# ⚠ queue.db holds real violation records and queue_images/ holds real photos
# of real people. Both are gitignored. Treat them as production data on the
# device: they are the reason a site's compliance record has no gaps, and they
# are also personal information sitting on a machine in a trailer.
#
# Replayed events deliberately never fire an SMS — a supervisor paged about a
# hazard from 40 minutes ago will walk out to nothing.
QUEUE_DB_PATH=queue.db
QUEUE_IMAGE_DIR=queue_images
REPLAY_SECONDS=30

# ── Supabase ────────────────────────────────────────────────────────────────
#
# ⚠ NO LONGER ON THE VIOLATION PATH as of Phase 3, Step 3.4.
#
# main.py does not read any of these. Violations go through the API above,
# which is the entire security win of that step: the service-role key bypasses
# every access rule in the database, and this process runs on a small computer
# in an unlocked job-site trailer.
#
# They remain here only because storage.py still exists and tests/test_storage.py
# exercises it directly. A REAL DEPLOYED DEVICE SHOULD NOT HAVE THESE SET.
SUPABASE_URL=
# Backend only. Bypasses RLS. Must never reach the dashboard, a browser, or a
# field device.
SUPABASE_SERVICE_ROLE_KEY=

# ── S3 (violation snapshots — snapshot mode only) ───────────────────────────
#
# ⚠ NO LONGER ON THE VIOLATION PATH as of Phase 3, Step 3.4.
#
# A device now uploads images to a presigned URL the API issues per violation —
# a link good for one file, at one path, for five minutes (ADR 0004). It holds
# no durable AWS credentials at all. Same reasoning as the Supabase block above:
# these stay for storage.py and its test, and a real deployed device should not
# have them set.
#
# The naming rule below still applies wherever these ARE used:
# these are S3_*, not AWS_*, and that is deliberate in two directions:
#
#   1. boto3's default credential chain reads AWS_ACCESS_KEY_ID and
#      AWS_SECRET_ACCESS_KEY and, failing those, falls back to
#      ~/.aws/credentials. On 2026-08-20 that fallback silently picked up a
#      deleted key from the old personal AWS account and every upload failed
#      with InvalidAccessKeyId. Using our own names means boto3 can never
#      discover credentials on its own — storage.py passes these explicitly, so
#      there is exactly one credential source.
#
#   2. The dashboard runs on Vercel, i.e. Lambda, where the runtime presets
#      AWS_REGION and AWS_ACCESS_KEY_ID to values that grant nothing. Keeping
#      one naming scheme across both services means the same variable means the
#      same thing everywhere.
#
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Company account buckets, ca-central-1. Use -dev locally.
# The old cordon-safety-violations-dev bucket is retired.
S3_BUCKET_NAME=allclear-violations-dev

# ── SES (email digests) ─────────────────────────────────────────────────────
# Separate from S3 on purpose: same region and key today, but they are
# different services and either could move independently.
SES_REGION=ca-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=  # supervisor's phone, single recipient for MVP

# ── Detection tuning ────────────────────────────────────────────────────────
DETECTION_CONFIDENCE_THRESHOLD=0.6
DEBOUNCE_FRAMES=5
COOLDOWN_SECONDS=60

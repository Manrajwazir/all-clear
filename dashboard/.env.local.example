# Assessment form -> email. Set these in Vercel project settings too.

# AWS SES.
#
# Note the SES_ prefix. These are NOT called AWS_REGION / AWS_ACCESS_KEY_ID
# on purpose: Vercel functions run on Lambda, which presets those names to
# the function's own region and to placeholder credentials. Using them would
# silently point the client at the wrong region. See app/api/assessment/route.ts.
#
# The IAM principal needs ses:SendEmail on the sending identity. The
# allclear-app user is scoped to S3 only, so this needs its own principal.
SES_REGION=ca-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Must be a verified identity in SES. While the account is in the SES
# sandbox the recipient must be verified as well, which is fine here since
# it is our own address. Verifying the whole allclearsafety.ca domain covers
# both of these at once.
ASSESSMENT_FROM_EMAIL=noreply@allclearsafety.ca
ASSESSMENT_TO_EMAIL=hello@allclearsafety.ca

# Upstash Redis, for per-IP rate limiting on the form endpoint.
# If these are absent the limiter fails open: the form still works, but only
# the honeypot and timing checks apply. See lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

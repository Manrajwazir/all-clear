# Assessment form -> email. Set these in Vercel project settings too.

# AWS SES. The IAM principal needs ses:SendEmail; the allclear-app user is
# currently scoped to S3 only, so its policy needs extending or a separate
# user creating.
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be a verified identity in SES. While the account is in the SES
# sandbox the recipient must be verified as well, which is fine here since
# it is our own address.
ASSESSMENT_FROM_EMAIL=noreply@allclearsafety.ca
ASSESSMENT_TO_EMAIL=hello@allclearsafety.ca

# Upstash Redis, for per-IP rate limiting on the form endpoint.
# If these are absent the limiter fails open: the form still works, but only
# the honeypot and timing checks apply. See lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

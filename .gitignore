.env
venv
__pycache__
*.pyc
detection/models/*.pt

# Outage queue (Phase 3, Step 3.5).
#
# NOT build artifacts — this is real data and it must never reach a repository.
# queue.db holds undelivered violation records; queue_images/ holds JPEGs of
# actual people on an actual site. A committed queue_images/ is a personal
# information disclosure, not a messy diff.
detection/queue.db
detection/queue.db-wal
detection/queue.db-shm
detection/queue_images/
# Renamed or backed-up queues, e.g. queue-rehearsal.db set aside 2026-09-26.
# Same contents, same reason to never commit them.
detection/queue*.db*
.vscode
.idea
.venv
/docs
# Simulated camera test clips (Labs4 block 1). Generated, and a real clip has a person in it.
detection/simcam/clips/
